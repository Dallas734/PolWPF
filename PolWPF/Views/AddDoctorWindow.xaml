<Window x:Class="PolWPF.Views.AddDoctorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PolWPF.Views"
        mc:Ignorable="d"
        Title="Добавить доктора" Height="450" Width="800"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Icon="..\Resources\icon.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label FontSize="16" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" FontWeight="Black">Специальность</Label>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top">Фамилия</Label>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top">Имя</Label>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="3" HorizontalAlignment="Left" VerticalAlignment="Top">Отчество</Label>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="4" HorizontalAlignment="Left" VerticalAlignment="Top">Дата рождения</Label>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="5" HorizontalAlignment="Left" VerticalAlignment="Top">Пол</Label>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="6" HorizontalAlignment="Left" VerticalAlignment="Top">Категория</Label>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="7" HorizontalAlignment="Left" VerticalAlignment="Top">Статус</Label>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="8" HorizontalAlignment="Left" VerticalAlignment="Top">Участок</Label>
        <ComboBox Grid.Column="1" Grid.Row="0" SelectedItem="{Binding SelectedSpecialization}" DisplayMemberPath="Name" SelectedValuePath="Id" ItemsSource="{Binding Path = DataContext.allSpecializations, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
        <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding SelectedLastName}"/>
        <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding SelectedFirstName}"/>
        <TextBox Grid.Column="1" Grid.Row="3" Text="{Binding SelectedSurname}"/>
        <ComboBox Grid.Column="1" Grid.Row="5" SelectedItem="{Binding SelectedGender}" DisplayMemberPath="Name" SelectedValuePath="Id" ItemsSource="{Binding Path=DataContext.allGenders, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
        <DatePicker Grid.Column="1" Grid.Row="4" x:Name="DateBirthDoctor" SelectedDate="{Binding SelectedDate}"/>
        <ComboBox Grid.Column="1" Grid.Row="6" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" SelectedValuePath="Id" ItemsSource="{Binding Path=DataContext.allCategories, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
        <ComboBox Grid.Column="1" Grid.Row="7" SelectedItem="{Binding SelectedStatus}" DisplayMemberPath="Name" SelectedValuePath="Id" ItemsSource="{Binding Path=DataContext.allStatus, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
        <ComboBox Grid.Column="1" Grid.Row="8" SelectedItem="{Binding SelectedArea}" DisplayMemberPath="Id" SelectedValuePath="Id" ItemsSource="{Binding Path=DataContext.allAreas, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
        <Button Grid.Column="1" Grid.Row="9" Margin="0,20, 0, 0" Content="Подтвердить" Command="{Binding SubmitCommand}"/>
    </Grid>
</Window>
