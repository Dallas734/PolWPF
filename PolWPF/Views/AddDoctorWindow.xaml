<Window x:Class="PolWPF.Views.AddDoctorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PolWPF.Views"
        mc:Ignorable="d"
        Title="AddDoctorWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top">Специальность</Label>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top">Фамилия</Label>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top">Имя</Label>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="3" HorizontalAlignment="Left" VerticalAlignment="Top">Отчество</Label>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="4" HorizontalAlignment="Left" VerticalAlignment="Top">Дата рождения</Label>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="5" HorizontalAlignment="Left" VerticalAlignment="Top">Категория</Label>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="6" HorizontalAlignment="Left" VerticalAlignment="Top">Статус</Label>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="7" HorizontalAlignment="Left" VerticalAlignment="Top">Участок</Label>
        <ComboBox Grid.Column="1" Grid.Row="0" Text="{Binding Specialization}"/>
        <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding LastName}"/>
        <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding FirstName}"/>
        <TextBox Grid.Column="1" Grid.Row="3" Text="{Binding Surname}"/>
        <DatePicker Grid.Column="1" Grid.Row="4" x:Name="DateBirthDoctor"/>
        <ComboBox Grid.Column="1" Grid.Row="5" Text="{Binding Category}"/>
        <ComboBox Grid.Column="1" Grid.Row="6" Text="{Binding Status}"/>
        <ComboBox Grid.Column="1" Grid.Row="7" Text="{Binding Area}"/>
        <Button Grid.Column="1" Grid.Row="8" Margin="0,20, 0, 0" Content="Подтвердить"/>
    </Grid>
</Window>
