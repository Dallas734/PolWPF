<Window x:Class="PolWPF.Views.AddPatientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PolWPF.Views"
        mc:Ignorable="d"
        Title="AddPatientWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top">Фамилия</Label>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top">Имя</Label>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top">Отчество</Label>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="3" HorizontalAlignment="Left" VerticalAlignment="Top">Пол</Label>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="4" HorizontalAlignment="Left" VerticalAlignment="Top">Дата рождения</Label>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="5" HorizontalAlignment="Left" VerticalAlignment="Top">Адрес</Label>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="6" HorizontalAlignment="Left" VerticalAlignment="Top">Полис</Label>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="7" HorizontalAlignment="Left" VerticalAlignment="Top">Место работы</Label>
        <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding LastName}"/>
        <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding FirstName}"/>
        <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding Surname}"/>
        <ComboBox Grid.Column="1" Grid.Row="3" Text="{Binding Gender}"/>
        <DatePicker Grid.Column="1" Grid.Row="4" x:Name="DateBirthPatient"/>
        <ComboBox Grid.Column="1" Grid.Row="5" Text="{Binding Address}"/>
        <TextBox Grid.Column="1" Grid.Row="6" Text="{Binding Polis}"/>
        <TextBox Grid.Column="1" Grid.Row="7" Text="{Binding WorkPlace}"/>
        <Button Grid.Column="2" Grid.Row="5" Margin="10, 0, 0, 0" Content="Добавить адрес"/>
        <Button Grid.Column="1" Grid.Row="8" Margin="0, 20, 0, 0" Content="Подтвердить"/>
    </Grid>
</Window>
