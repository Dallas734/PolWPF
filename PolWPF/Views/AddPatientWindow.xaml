<Window x:Class="PolWPF.Views.AddPatientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PolWPF.Views"
        mc:Ignorable="d"
        Title="AddPatientWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top">Фамилия</Label>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top">Имя</Label>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top">Отчество</Label>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="3" HorizontalAlignment="Left" VerticalAlignment="Top">Пол</Label>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="4" HorizontalAlignment="Left" VerticalAlignment="Top">Дата рождения</Label>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="5" HorizontalAlignment="Left" VerticalAlignment="Top">Участок</Label>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="6" HorizontalAlignment="Left" VerticalAlignment="Top">Адрес</Label>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="7" HorizontalAlignment="Left" VerticalAlignment="Top">Полис</Label>
        <Label FontSize="16" FontWeight="Black" Grid.Column="0"  Grid.Row="8" HorizontalAlignment="Left" VerticalAlignment="Top">Место работы</Label>
        <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding SelectedLastName}"/>
        <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding SelectedFirstName}"/>
        <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding SelectedSurname}"/>
        <ComboBox Grid.Column="1" Grid.Row="3" SelectedItem="{Binding SelectedGender}" DisplayMemberPath="Name" SelectedValuePath="Id" ItemsSource="{Binding Path=DataContext.allGenders, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
        <DatePicker Grid.Column="1" Grid.Row="4" x:Name="DateBirthPatient" SelectedDate="{Binding SelectedDate}"/>
        <ComboBox x:Name="combobox1" Grid.Column="1" Grid.Row="5" SelectedItem="{Binding SelectedArea}" DisplayMemberPath="Id" SelectedValuePath="Id" ItemsSource="{Binding Path=DataContext.allAreas, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" />
        <ComboBox Grid.Column="1" Grid.Row="6" SelectedItem="{Binding SelectedAddress}" DisplayMemberPath="Name" SelectedValuePath="Id" ItemsSource="{Binding SelectedItem.Addresses, ElementName=combobox1}" IsSynchronizedWithCurrentItem="True"/>
        <TextBox Grid.Column="1" Grid.Row="7" Text="{Binding SelectedPolis}"/>
        <TextBox Grid.Column="1" Grid.Row="8" Text="{Binding SelectedWorkPlace}"/>
        <Button Grid.Column="1" Grid.Row="9" Margin="0, 20, 0, 0" Content="Подтвердить" Command="{Binding SubmitCommand}"/>
    </Grid>
</Window>
