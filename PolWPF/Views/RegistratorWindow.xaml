<Window x:Class="PolWPF.RegistratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PolWPF"
        mc:Ignorable="d"
        Title="RegistratorWindow" Height="480" Width="1300"
        xmlns:materialDesignMahApps="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Window.Resources>
        <CollectionViewSource x:Key="Specializations" Source="{Binding allSpecializations}"/>
    </Window.Resources>
    <Grid x:Name="BackGrid">
        <TabControl TabStripPlacement="Left" BorderThickness="5, 10, 15, 20" BorderBrush="Black">
            <TabItem Header="Пациенты">
                <TabControl BorderThickness="5, 10, 15, 20" BorderBrush="Black">
                    <TabItem Header="Сведения о пациенте">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="Black" Grid.Row="0" BorderThickness="1"></Border>
                            <Border BorderBrush="Black" Grid.Row="1" BorderThickness="1"></Border>
                            <StackPanel Grid.Row="0" Margin="0, 5, 0, 10" Grid.ColumnSpan="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="AddPatientsBtn" Grid.Column="0" Width="200" Content="Добавить пациента" HorizontalAlignment="Left" Margin="10, 0, 0, 0" Command="{Binding AddPatientCommand}"/>
                                    <Button x:Name="DeletePatientBtn" Grid.Column="1" Width="200" Content="Удалить пациента" HorizontalAlignment="Left" Margin="10, 0, 0, 0" Command="{Binding RemovePatientCommand}" CommandParameter="{Binding SelectedPatient}"/>
                                    <Button x:Name="SavePatientBtn" Grid.Column="2" Width="200" Content="Сохранить изменения" HorizontalAlignment="Left" Margin="10, 0, 0, 0" Command="{Binding SavePatientCommand}" CommandParameter="{Binding SelectedPatient}"/>
                                </Grid>
                            </StackPanel>
                            <DataGrid x:Name="PatientGridInfo" Grid.Row="1" ItemsSource="{Binding allPatients}" SelectedItem="{Binding SelectedPatient, Mode=TwoWay}" VerticalAlignment="Top" Grid.RowSpan="2" Margin="1, 1, 0, 0" AutoGenerateColumns="False" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="Auto"/>
                                    <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="Auto"/>
                                    <DataGridTextColumn Header="Отчество" Binding="{Binding Surname}" Width="Auto"/>
                                    <DataGridTemplateColumn Header="Пол">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox x:Name="Combo18" DisplayMemberPath="Name" SelectedValue="{Binding Gender_id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Id" ItemsSource="{Binding Path=DataContext.allGenders, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="Auto"/>
                                    <DataGridTextColumn Header="Дата рождения" Binding="{Binding DateOfBirth, StringFormat=d}" Width="Auto"/>
                                    <DataGridTemplateColumn Header="Адрес">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox x:Name="Combo4" DisplayMemberPath="Name" SelectedValue="{Binding  Address_id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Id" ItemsSource="{Binding Path=DataContext.allAddresses, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Полис" Binding="{Binding Polis}" Width="Auto"/>
                                    <DataGridTextColumn Header="Место работы" Binding="{Binding WorkPlace}" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem  Header="Записать пациента">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="Black" BorderThickness="1">
                                <StackPanel Grid.Row="0" Margin="0, 5, 0, 10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Label FontSize="16" FontWeight="Black" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">Специальность</Label>
                                        <ComboBox x:Name="SpecComboAddVisit" Width="216" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                        <Label FontSize="16" FontWeight="Black" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Top">Врач</Label>
                                        <ComboBox x:Name="DoctorComboAddVisit" Width="216" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border BorderBrush="Black" BorderThickness="1">
                                    <local:SheduleDay x:Name="ScheduleDayRegistator"/>
                                </Border>
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <GroupBox x:Name="guicEvent" Header="Сведения о записи" Margin="4" Grid.Row="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Label Grid.Column="0" Grid.Row="0" Content="Дата:"/>
                                            <Label Grid.Column="0" Grid.Row="1" Content="Время:"/>
                                            <Label Grid.Column="0" Grid.Row="2" Content="Врач:"/>
                                            <Label Grid.Column="0" Grid.Row="3" Content="Пациент:"/>
                                            <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Start, StringFormat={}{0:D}}"/>
                                            <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Start, StringFormat={}{0:t}}"/>
                                            <TextBlock Grid.Column="1" Grid.Row="3" Text="{Binding DoctorT}"/>
                                            <TextBlock Grid.Column="1" Grid.Row="4" Text="{Binding PatientT}"/>
                                        </Grid>
                                    </GroupBox>
                                    <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="4">
                                        <Button Content="Удалить запись" x:Name="guifEventDelete" Margin="8,0,0,0" IsEnabled="False"/>
                                    </StackPanel>
                                    <GroupBox x:Name="guicEventEdit" Header="Новая запись" Margin="4" Grid.Row="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Label Grid.Column="0" Grid.Row="0" Content="Дата:"/>
                                            <Label Grid.Column="0" Grid.Row="1" Content="Время:"/>
                                            <Label Grid.Column="0" Grid.Row="2" Content="Пациент:"/>
                                            <DatePicker x:Name="guiEventEditDate" Grid.Column="1" Grid.Row="0"/>
                                            <materialDesignMahApps:TimePicker x:Name="guiEventEditTime" Grid.Column="1" Grid.Row="1"/>
                                            <ComboBox x:Name="PatientComboAddVisit" Grid.Column="1" Grid.Row="2"/>
                                            <Button x:Name="guiEventEditSave" Grid.Column="1" Grid.Row="5" Content="Создать" HorizontalAlignment="Left" Width="100" Margin="0, 2, 0, 0"/>
                                        </Grid>
                                        
                                    </GroupBox>
                                </Grid>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Записи пациента">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="Black" BorderThickness="1">
                                <StackPanel Grid.Row="0" Margin="0, 5, 0, 10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label FontSize="16" FontWeight="Black" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">Пациент</Label>
                                        <ComboBox x:Name="PatientVisitsInfo" Width="216" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border BorderBrush="Black" BorderThickness="1">
                                    <local:SheduleDay x:Name="SheduleDay" />
                                </Border>
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <GroupBox Header="Дата" BorderBrush="Black">
                                        <StackPanel Orientation="Vertical">
                                            <DatePicker x:Name="guidDate"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Content="Пред" x:Name="guifDatePrev" Grid.Column="0" Margin="4"/>
                                                <Button Content="Сегодня" x:Name="guifDateToday" Grid.Column="1" Margin="4"/>
                                                <Button Content="След" x:Name="guifDateNext" Grid.Column="2" Margin="4"/>
                                            </Grid>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox x:Name="VisitInfo" Header="Сведения о записи" Margin="4" Grid.Row="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Label Grid.Column="0" Grid.Row="0" Content="Дата:"/>
                                            <Label Grid.Column="0" Grid.Row="1" Content="Время:"/>
                                            <Label Grid.Column="0" Grid.Row="2" Content="Врач:"/>
                                            <Label Grid.Column="0" Grid.Row="3" Content="Пациент:"/>
                                            <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Start, StringFormat={}{0:D}}"/>
                                            <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Start, StringFormat={}{0:t}}"/>
                                            <TextBlock Grid.Column="1" Grid.Row="3" Text="{Binding DoctorT}"/>
                                            <TextBlock Grid.Column="1" Grid.Row="4" Text="{Binding PatientT}"/>
                                        </Grid>
                                    </GroupBox>
                                </Grid>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Карта пациента">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="Black" Grid.Row="0" BorderThickness="1"></Border>
                            <Border BorderBrush="Black" Grid.Row="1" BorderThickness="1"></Border>
                            <StackPanel Grid.Row="0" Margin="0, 5, 0, 10" Grid.ColumnSpan="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label FontSize="16" FontWeight="Black" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">Пациент</Label>
                                    <ComboBox x:Name="PatientCard" Width="216" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                </Grid>
                            </StackPanel>
                            <DataGrid x:Name="CardGrid" Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}" VerticalAlignment="Top" Grid.RowSpan="2" Margin="1, 1, 0, 0"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>
            <TabItem Header="Врачи">
                <TabControl>
                    <TabItem Header="Сведения о врачах (участки, статус)">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="Black" Grid.Row="0" BorderThickness="1"></Border>
                            <Border BorderBrush="Black" Grid.Row="1" BorderThickness="1"></Border>
                            <StackPanel Grid.Row="0" Margin="0, 5, 0, 10" Grid.ColumnSpan="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="AddDoctorBtn" Grid.Column="0" Width="200" Content="Добавить доктора" HorizontalAlignment="Left" Margin="10, 0, 0, 0" Command="{Binding AddDoctorCommand}"/>
                                    <Button x:Name="DeleteDoctorBtn" Grid.Column="1" Width="200" Content="Удалить доктора" HorizontalAlignment="Left" Margin="10, 0, 0, 0" Command="{Binding RemoveDoctorCommand}" CommandParameter="{Binding SelectedDoctor}"/>
                                    <Button x:Name="SaveDoctorBtn" Grid.Column="2" Width="200" Content="Сохранить изменения" HorizontalAlignment="Left" Margin="10, 0, 0, 0" Command="{Binding SaveDoctorCommand}" CommandParameter="{Binding SelectedDoctor}"/>
                                </Grid>
                            </StackPanel>
                            <DataGrid x:Name="DoctorGridInfo" Grid.Row="1" ItemsSource="{Binding allDoctors}" SelectedItem="{Binding SelectedDoctor, Mode=TwoWay}" VerticalAlignment="Top" Grid.RowSpan="2" Margin="1, 1, 0, 0" AutoGenerateColumns="False" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Специальность">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                                <ComboBox x:Name="Combo1" DisplayMemberPath="Name" SelectedValue="{Binding Specialization_id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Id" ItemsSource="{Binding Path=DataContext.allSpecializations, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate> 
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="Auto"/>
                                    <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="Auto"/>
                                    <DataGridTextColumn Header="Отчество" Binding="{Binding Surname}"  Width="Auto"/>
                                    <DataGridTemplateColumn Header="Пол">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox x:Name="Combo3" DisplayMemberPath="Name" SelectedValue="{Binding Gender_id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Id" ItemsSource="{Binding Path=DataContext.allGenders, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Дата рождения" Binding="{Binding DateOfBirth, StringFormat=d}" Width="Auto"/>
                                    <DataGridTemplateColumn Header="Статус">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox x:Name="Combo2" DisplayMemberPath="Name" SelectedValue="{Binding Status_id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Id" ItemsSource="{Binding Path=DataContext.allStatus, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Участок" Binding="{Binding Area_id}" Width="Auto"/>
                                    <DataGridTemplateColumn Header="Категория">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox x:Name="Combo3" DisplayMemberPath="Name" SelectedValue="{Binding Category_id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Id" ItemsSource="{Binding Path=DataContext.allCategories, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Расписание врача">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="Black" BorderThickness="1">
                                <StackPanel Grid.Row="0" Margin="0, 5, 0, 10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Label FontSize="16" FontWeight="Black" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">Врач</Label>
                                        <ComboBox x:Name="DoctorSheduleInfo" Width="216" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Label x:Name="Monday" FontSize="16" FontWeight="Black" HorizontalAlignment="Left">Понедельник</Label>
                                    <Label x:Name="Tuesday" FontSize="16" FontWeight="Black" HorizontalAlignment="Left">Вторник</Label>
                                    <Label x:Name="Wednesday" FontSize="16" FontWeight="Black" HorizontalAlignment="Left">Среда</Label>
                                    <Label x:Name="Thursday" FontSize="16" FontWeight="Black" HorizontalAlignment="Left">Четверг</Label>
                                    <Label x:Name="Friday" FontSize="16" FontWeight="Black" HorizontalAlignment="Left">Пятница</Label>
                                    <Label x:Name="Saturday" FontSize="16" FontWeight="Black" HorizontalAlignment="Left">Суббота</Label>
                                    <Label x:Name="Sunday" FontSize="16" FontWeight="Black" HorizontalAlignment="Left">Воскресенье</Label>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <materialDesignMahApps:TimePicker x:Name="MondayBeginTime" Width="100" Margin="0, 1, 0, 0"/>
                                    <materialDesignMahApps:TimePicker x:Name="TuesdayBeginTime" Width="100" Margin="0, 5, 0, 0"/>
                                    <materialDesignMahApps:TimePicker x:Name="WednesdayBeginTime" Width="100" Margin="0, 5, 0, 0"/>
                                    <materialDesignMahApps:TimePicker x:Name="ThursdayBeginTime" Width="100" Margin="0, 5, 0, 0"/>
                                    <materialDesignMahApps:TimePicker x:Name="FridayBeginTime" Width="100" Margin="0, 5, 0, 0"/>
                                    <materialDesignMahApps:TimePicker x:Name="SaturdayBeginTime" Width="100" Margin="0, 5, 0, 0"/>
                                    <materialDesignMahApps:TimePicker x:Name="SundayBeginTime" Width="100" Margin="0, 5, 0, 0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="30,0 ,0, 0">
                                    <materialDesignMahApps:TimePicker x:Name="MondayEndTime" Width="100" Margin="0, 1, 0, 0"/>
                                    <materialDesignMahApps:TimePicker x:Name="TuesdayEndTime" Width="100" Margin="0, 5, 0, 0"/>
                                    <materialDesignMahApps:TimePicker x:Name="WednesdayEndTime" Width="100" Margin="0, 5, 0, 0"/>
                                    <materialDesignMahApps:TimePicker x:Name="ThursdayEndTime" Width="100" Margin="0, 5, 0, 0"/>
                                    <materialDesignMahApps:TimePicker x:Name="FridayEndTime" Width="100" Margin="0, 5, 0, 0"/>
                                    <materialDesignMahApps:TimePicker x:Name="SaturdayEndTime" Width="100" Margin="0, 5, 0, 0"/>
                                    <materialDesignMahApps:TimePicker x:Name="SundayEndTime" Width="100" Margin="0, 5, 0, 0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Записи врача">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="Black" BorderThickness="1">
                                <StackPanel Grid.Row="0" Margin="0, 5, 0, 10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Label FontSize="16" FontWeight="Black" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">Врач</Label>
                                        <ComboBox x:Name="DoctorVisitsInfo" Width="216" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border BorderBrush="Black" BorderThickness="1">
                                    <local:SheduleDay x:Name="SheduleDayDoctor" />
                                </Border>
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <GroupBox Header="Дата" BorderBrush="Black">
                                        <StackPanel Orientation="Vertical">
                                            <DatePicker x:Name="guidDateDoctor"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Content="Пред" x:Name="guifDatePrevDoctor" Grid.Column="0" Margin="4"/>
                                                <Button Content="Сегодня" x:Name="guifDateTodayDoctor" Grid.Column="1" Margin="4"/>
                                                <Button Content="След" x:Name="guifDateNextDoctor" Grid.Column="2" Margin="4"/>
                                            </Grid>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox x:Name="DoctorVisitInfo" Header="Сведения о записи" Margin="4" Grid.Row="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Label Grid.Column="0" Grid.Row="0" Content="Дата:"/>
                                            <Label Grid.Column="0" Grid.Row="1" Content="Время:"/>
                                            <Label Grid.Column="0" Grid.Row="2" Content="Врач:"/>
                                            <Label Grid.Column="0" Grid.Row="3" Content="Пациент:"/>
                                            <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Start, StringFormat={}{0:D}}"/>
                                            <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Start, StringFormat={}{0:t}}"/>
                                            <TextBlock Grid.Column="1" Grid.Row="3" Text="{Binding DoctorT}"/>
                                            <TextBlock Grid.Column="1" Grid.Row="4" Text="{Binding PatientT}"/>
                                        </Grid>
                                    </GroupBox>
                                </Grid>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Статистика посещений на участке">
                    </TabItem>
                </TabControl>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
