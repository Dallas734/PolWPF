<Window x:Class="PolWPF.RegistratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PolWPF"
        mc:Ignorable="d"
        Title="RegistratorWindow" Height="480" Width="1500"
        xmlns:materialDesignMahApps="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:lrm="clr-namespace:System.Windows.Controls.DataVisualization.Charting;assembly=DotNetProjects.DataVisualization.Toolkit"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf">
    <Window.Resources>
        <CollectionViewSource x:Key="Specializations" Source="{Binding AllSpecializations}"/>
    </Window.Resources>
    <Grid x:Name="BackGrid">
        <TabControl TabStripPlacement="Left" BorderThickness="5, 10, 15, 20" BorderBrush="Black">
            <TabItem Header="Пациенты">
                <TabControl BorderThickness="5, 10, 15, 20" BorderBrush="Black">
                    <TabItem Header="Сведения о пациенте">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="Black" Grid.Row="0" BorderThickness="1"></Border>
                            <Border BorderBrush="Black" Grid.Row="1" BorderThickness="1"></Border>
                            <StackPanel Grid.Row="0" Margin="0, 5, 0, 10" Grid.ColumnSpan="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="AddPatientsBtn" Grid.Column="0" Width="200" Content="Добавить пациента" HorizontalAlignment="Left" Margin="10, 0, 0, 0" Command="{Binding AddPatientCommand}"/>
                                    <Button x:Name="DeletePatientBtn" Grid.Column="1" Width="200" Content="Удалить пациента" HorizontalAlignment="Left" Margin="10, 0, 0, 0" Command="{Binding RemovePatientCommand}" CommandParameter="{Binding SelectedPatient}"/>
                                    <Button x:Name="SavePatientBtn" Grid.Column="2" Width="200" Content="Сохранить изменения" HorizontalAlignment="Left" Margin="10, 0, 0, 0" Command="{Binding SavePatientCommand}" CommandParameter="{Binding SelectedPatient}"/>
                                </Grid>
                            </StackPanel>
                            <DataGrid x:Name="PatientGridInfo" Grid.Row="1" ItemsSource="{Binding AllPatients}" SelectedItem="{Binding SelectedPatient, Mode=TwoWay}" VerticalAlignment="Top" Grid.RowSpan="2" Margin="1, 1, 0, 0" AutoGenerateColumns="False" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="Auto"/>
                                    <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="Auto"/>
                                    <DataGridTextColumn Header="Отчество" Binding="{Binding Surname}" Width="Auto"/>
                                    <DataGridTemplateColumn Header="Пол">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox x:Name="Combo18" DisplayMemberPath="Name" SelectedValue="{Binding Gender_id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Id" ItemsSource="{Binding Path=DataContext.AllGenders, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="Auto"/>
                                    <DataGridTextColumn Header="Дата рождения" Binding="{Binding DateOfBirth, StringFormat=d}" Width="Auto"/>
                                    <DataGridTemplateColumn Header="Адрес">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox x:Name="Combo4" DisplayMemberPath="Name" SelectedValue="{Binding  Address_id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Id" ItemsSource="{Binding Path=DataContext.AllAddresses, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Полис" Binding="{Binding Polis}" Width="Auto"/>
                                    <DataGridTextColumn Header="Место работы" Binding="{Binding WorkPlace}" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem  Header="Записать пациента">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="Black" BorderThickness="1">
                                <StackPanel Grid.Row="0" Margin="0, 5, 0, 10">
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Label FontSize="16" FontWeight="Black" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">Участок</Label>
                                        <ComboBox x:Name="AreaComboAddVisit" Width="216" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top" SelectedItem="{Binding SelectedArea}" DisplayMemberPath="Id" SelectedValuePath="Id" ItemsSource="{Binding Path = DataContext.AllAreas, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                                        <Label FontSize="16" FontWeight="Black" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Top">Специальность</Label>
                                        <ComboBox x:Name="SpecComboAddVisit" Width="216" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Top" SelectedItem="{Binding SelectedSpecialization}" DisplayMemberPath="Name" SelectedValuePath="Id" ItemsSource="{Binding Path = DataContext.AllSpecializations, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                                        <Label FontSize="16" FontWeight="Black" Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Top">Врач</Label>
                                        <ComboBox x:Name="DoctorComboAddVisit" Width="216" Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Top" SelectedItem="{Binding SelectedDoctor}" DisplayMemberPath="FullName" SelectedValuePath="Id" ItemsSource="{Binding Path = DataContext.AllNowDoctors, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                                        <Label FontSize="16" FontWeight="Black" Grid.Column="6" HorizontalAlignment="Left" VerticalAlignment="Top">Пациент</Label>
                                        <ComboBox x:Name="PatientComboAddVisit" Width="216" Grid.Column="7" HorizontalAlignment="Center" VerticalAlignment="Top" SelectedItem="{Binding SelectedPatient}" DisplayMemberPath="FullName" SelectedValuePath="Id" ItemsSource="{Binding Path = DataContext.AllNowPatients, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                                        <Button x:Name="AddVisitBtn" Grid.Column="8" Content="Записать" Command="{Binding AddVisitCommand}" Margin ="15, 0, 0,0 " CommandParameter="{Binding SelectedTalon}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                    <DatePicker x:Name="AddVisitDate"  Grid.Column="0" HorizontalAlignment="Center" SelectedDate="{Binding SelectedDate}" Width="100" Margin="0, 10, 0, 10"/>
                                    <Button x:Name="GetTalonsBtn" Grid.Column="1" Content="Показать талоны" Margin="15, 0, 0, 0" Command="{Binding GetTalonsCommand}"/>
                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border BorderBrush="Black" BorderThickness="1">
                                    <DataGrid x:Name="AddVisitGridInfo" Grid.Row="1" ItemsSource="{Binding Talons, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding SelectedTalon, Mode=TwoWay}" VerticalAlignment="Top" Grid.RowSpan="2" Margin="1, 1, 0, 0" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Время" Binding="{Binding Time}" Width="*"/>
                                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <GroupBox x:Name="guicEvent" Header="Сведения о записи" Margin="4" Grid.Row="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Label Grid.Column="0" Grid.Row="0" Content="Дата:"/>
                                            <Label Grid.Column="0" Grid.Row="1" Content="Время:"/>
                                            <Label Grid.Column="0" Grid.Row="2" Content="Врач:"/>
                                            <Label Grid.Column="0" Grid.Row="3" Content="Пациент:"/>
                                            <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding SelectedTalon.Date, StringFormat={}{0:D},  ConverterCulture=ru}"/>
                                            <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding SelectedTalon.Time, StringFormat={}{0:t}}"/>
                                            <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding SelectedDoctor.FullName}"/>
                                            <TextBlock Grid.Column="1" Grid.Row="3" Text="{Binding SelectedTalon.Patient.FullName}"/>
                                        </Grid>
                                    </GroupBox>
                                    <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="4">
                                        <Button Content="Удалить запись" x:Name="guifEventDelete" Margin="8,0,0,0" Command="{Binding RemoveVisitCommand}" CommandParameter="{Binding SelectedTalon}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Записи пациента">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="Black" BorderThickness="1">
                                <StackPanel Grid.Row="0" Margin="0, 5, 0, 10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Label FontSize="16" FontWeight="Black" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">Пациент</Label>
                                        <ComboBox x:Name="PatientVisitsInfo" Width="216" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top" SelectedItem="{Binding SelectedVisitPatient}" DisplayMemberPath="FullName" SelectedValuePath="Id" ItemsSource="{Binding Path = DataContext.AllPatients, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                                        <Label FontSize="16" FontWeight="Black" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Top">Дата</Label>
                                        <DatePicker x:Name="PatientVisitsDatePicker" Width="216" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Top" SelectedDate="{Binding SelectedVisitDate}"/>
                                        <Button Content="Показать" Grid.Column="4" Margin="10, 0, 0, 0" Command="{Binding ShowPatientVisits}"/>
                                        <Button Content="Удалить" Grid.Column="6" Margin="10, 0, 0, 0" Command="{Binding DeletePatientVisits}" CommandParameter="{Binding SelectedFutureVisit}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border BorderBrush="Black" BorderThickness="1">
                                    <DataGrid ItemsSource="{Binding AllPatientVisit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  SelectedItem="{Binding SelectedFutureVisit}" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Врач" Width="*" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox x:Name="Combo1" DisplayMemberPath="FullName" SelectedValue="{Binding Doctor_id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Id" ItemsSource="{Binding Path=DataContext.AllDoctors, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" IsEnabled="False"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Дата" Binding="{Binding DateT, StringFormat=d}" IsReadOnly="True" Width="*"></DataGridTextColumn>
                                            <DataGridTextColumn Header="Время" Binding="{Binding TimeT}" IsReadOnly="True" Width="*"></DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Карта пациента">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="Black" Grid.Row="0" BorderThickness="1"></Border>
                            <Border BorderBrush="Black" Grid.Row="1" BorderThickness="1"></Border>
                            <StackPanel Grid.Row="0" Margin="0, 5, 0, 10" Grid.ColumnSpan="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Label FontSize="16" FontWeight="Black" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">Пациент</Label>
                                    <ComboBox  Width="216" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top" SelectedItem="{Binding SelectedCardPatient}" DisplayMemberPath="FullName" SelectedValuePath="Id" ItemsSource="{Binding Path = DataContext.AllPatients, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                                    <Button Content="Показать" Grid.Column="2" Margin="10, 0, 0, 0" Command="{Binding ShowPatientCard}" CommandParameter="{Binding SelectedCardPatient}"/>
                                </Grid>
                            </StackPanel>
                            <DataGrid x:Name="CardGrid" Grid.Row="1" ItemsSource="{Binding PatientCard}" VerticalAlignment="Top" Grid.RowSpan="2" Margin="1, 1, 0, 0" AutoGenerateColumns="False" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Врач" Width="*" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox x:Name="Combo1" DisplayMemberPath="FullName" SelectedValue="{Binding Doctor_id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Id" ItemsSource="{Binding Path=DataContext.AllDoctors, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" IsEnabled="False"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Дата" Binding="{Binding DateT, StringFormat=d}" IsReadOnly="True" Width="*"></DataGridTextColumn>
                                    <DataGridTextColumn Header="Время" Binding="{Binding TimeT}" IsReadOnly="True" Width="*"></DataGridTextColumn>
                                    <DataGridTemplateColumn Header="Диагноз" Width="*" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox DisplayMemberPath="Name" SelectedValue="{Binding Diagnosis_id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Id" ItemsSource="{Binding Path=DataContext.AllDiagnosis, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" IsEnabled="False"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Рецепт" Binding="{Binding Recipe}" IsReadOnly="True" Width="*"/>
                                    <DataGridTemplateColumn Header="Процедура" Width="*" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox DisplayMemberPath="Name" SelectedValue="{Binding Diagnosis_id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Id" ItemsSource="{Binding Path=DataContext.AllProcedures, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" IsEnabled="False"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>
            <TabItem Header="Врачи">
                <TabControl>
                    <TabItem Header="Сведения о врачах (участки, статус)">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="Black" Grid.Row="0" BorderThickness="1"></Border>
                            <Border BorderBrush="Black" Grid.Row="1" BorderThickness="1"></Border>
                            <StackPanel Grid.Row="0" Margin="0, 5, 0, 10" Grid.ColumnSpan="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="AddDoctorBtn" Grid.Column="0" Width="200" Content="Добавить доктора" HorizontalAlignment="Left" Margin="10, 0, 0, 0" Command="{Binding AddDoctorCommand}"/>
                                    <Button x:Name="DeleteDoctorBtn" Grid.Column="1" Width="200" Content="Удалить доктора" HorizontalAlignment="Left" Margin="10, 0, 0, 0" Command="{Binding RemoveDoctorCommand}" CommandParameter="{Binding SelectedDoctor}"/>
                                    <Button x:Name="SaveDoctorBtn" Grid.Column="2" Width="200" Content="Сохранить изменения" HorizontalAlignment="Left" Margin="10, 0, 0, 0" Command="{Binding SaveDoctorCommand}" CommandParameter="{Binding SelectedDoctor}"/>
                                </Grid>
                            </StackPanel>
                            <DataGrid x:Name="DoctorGridInfo" Grid.Row="1" ItemsSource="{Binding AllDoctors}" SelectedItem="{Binding SelectedDoctor, Mode=TwoWay}" VerticalAlignment="Top" Grid.RowSpan="2" Margin="1, 1, 0, 0" AutoGenerateColumns="False" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Специальность">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                                <ComboBox x:Name="Combo1" DisplayMemberPath="Name" SelectedValue="{Binding Specialization_id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Id" ItemsSource="{Binding Path=DataContext.AllSpecializations, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate> 
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="Auto"/>
                                    <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="Auto"/>
                                    <DataGridTextColumn Header="Отчество" Binding="{Binding Surname}"  Width="Auto"/>
                                    <DataGridTemplateColumn Header="Пол">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox x:Name="Combo3" DisplayMemberPath="Name" SelectedValue="{Binding Gender_id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Id" ItemsSource="{Binding Path=DataContext.AllGenders, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Дата рождения" Binding="{Binding DateOfBirth, StringFormat=d}" Width="Auto"/>
                                    <DataGridTemplateColumn Header="Статус">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox x:Name="Combo2" DisplayMemberPath="Name" SelectedValue="{Binding Status_id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Id" ItemsSource="{Binding Path=DataContext.AllStatus, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Участок" Binding="{Binding Area_id}" Width="Auto"/>
                                    <DataGridTemplateColumn Header="Категория">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox x:Name="Combo3" DisplayMemberPath="Name" SelectedValue="{Binding Category_id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Id" ItemsSource="{Binding Path=DataContext.AllCategories, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Расписание врача">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="Black" Grid.Row="0" BorderThickness="1"></Border>
                            <Border BorderBrush="Black" Grid.Row="1" BorderThickness="1"></Border>
                            <Border BorderBrush="Black" BorderThickness="1">
                                <StackPanel Grid.Row="0" Margin="0, 5, 0, 10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Label FontSize="16" FontWeight="Black" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">Врач</Label>
                                        <ComboBox x:Name="DoctorSheduleInfo" Grid.Column="1" Width="216" SelectedItem="{Binding SelectedSheduleDoctor}" DisplayMemberPath="FullName" SelectedValuePath="Id" ItemsSource="{Binding Path = DataContext.AllDoctors, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                                        <Button Content="Показать" Grid.Column="2" Command="{Binding GetSheduleCommand}" CommandParameter="{Binding SelectedSheduleDoctor}" Margin="15, 0, 0, 0"/>
                                        <Button Content="Сохранить" Grid.Column="3" Command="{Binding SaveSheduleCommand}" CommandParameter="{Binding SelectedSheduleItem}" Margin="15, 0, 0, 0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="1">
                                    <DataGrid ItemsSource="{Binding DoctorShedule}" SelectedItem="{Binding SelectedSheduleItem}" AutoGenerateColumns="False" CanUserAddRows="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="День недели" Binding="{Binding DayName}" Width="*" IsReadOnly="True"></DataGridTextColumn>
                                            <DataGridTemplateColumn Header="Начало" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <xctk:TimePicker Value="{Binding newBeginTime, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" StartTime="08:00" EndTime="20:00" TimeInterval="00:30:00"/>
                                                </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Конец" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                    <xctk:TimePicker Value="{Binding newEndTime, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" StartTime="08:00" EndTime="20:00" TimeInterval="00:30:00"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Статистика посещений на участке">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="Black" Grid.Row="0" BorderThickness="1"></Border>
                            <Border BorderBrush="Black" Grid.Row="1" BorderThickness="1"></Border>
                            <Grid Grid.Row="0" Margin="0, 10, 0, 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition  Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <Label FontSize="16" FontWeight="Black" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">Участок</Label>
                                <ComboBox x:Name="AreaComboReport" Width="216" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top" SelectedItem="{Binding SelectedReportArea}" DisplayMemberPath="Id" SelectedValuePath="Id" ItemsSource="{Binding Path = DataContext.AllAreas, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                                <Button Content="Составить отчёт" Width="200" Grid.Column="2" Margin="20, 0, 0, 0" Command="{Binding GetReportCommand}" CommandParameter="{Binding SelectedReportArea}"/>
                                <Button Content="Сохранить в файл" Width="200" Grid.Column="3" Margin="20, 0, 0, 0" Command="{Binding SaveFileCommand}" CommandParameter="{Binding SelectedReportArea}"/>
                            </Grid>
                            <lvc:PieChart Grid.Row="1" Margin="0, 10, 0, 0" Series="{Binding Series}" Hoverable="True" LegendLocation="Bottom"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
