<Window x:Class="PolWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PolWPF"
        mc:Ignorable="d"
        Title="Система работы с персоналом и пациентами" Height="450" Width="800"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Resources/MainWindow.jpg"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Label Content="Система работы с поликлиникой" Grid.Row="0" HorizontalAlignment="Center" Height="72" Margin="20, 0, 0, 0" VerticalAlignment="Top" Width="768" FontFamily="Castellar" FontSize="48" Foreground="Black"/>
        <Rectangle Fill="Black" HorizontalAlignment="Center" Grid.Row="0" Height="4" VerticalAlignment="Bottom" Stroke="#00000000" Width="659" RenderTransformOrigin="0.5,0.5"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="DocB" Grid.Column="0" Content="Войти как доктор" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontFamily="Candara Light" FontSize="18" Background="#002E4C21" Foreground="#FF080202" BorderBrush="#FF080202" RenderTransformOrigin="1.734,0.287" Height="32" Width="220" Command="{Binding DoctorAutCommand}"/>
            <Button x:Name="AdmB"  Grid.Column="1" Content="Войти как регистратор" HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="231" Height="36" FontFamily="Candara Light" FontSize="18" Background="#002E4C21" Foreground="#FF080202" BorderBrush="#FF080202" RenderTransformOrigin="1.734,0.287" Command="{Binding RegistratorAutCommand}"/>
        </Grid>
    </Grid>
</Window>
