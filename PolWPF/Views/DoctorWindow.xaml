<Window x:Class="PolWPF.DoctorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PolWPF"
        mc:Ignorable="d"
        Title="Окно врача" Height="450" Width="1200"
        xmlns:materialDesignMahApps="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        WindowState="Maximized"
        Icon="..\Resources\icon.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <MenuItem Header="Выход" Grid.Row="0" HorizontalAlignment="Left" Command="{Binding ToMainWindowCommand}"/>
            <MenuItem Header="О программе" Grid.Column="1" HorizontalAlignment="Left" Command="{Binding ToAboutWindowCommand}"/>
        </Grid>
        <TextBlock Name="LoginText" FontSize="16" FontWeight="Black" HorizontalAlignment="Right" Margin="0, 0, 10, 0"></TextBlock>
        <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1"/>
        <TabControl Grid.Column="0" TabStripPlacement="Left" BorderThickness="5, 10, 15, 20" BorderBrush="Black" Grid.Row="1">
            <TabItem Header="Карта пациента">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="Black" Grid.Row="0" BorderThickness="1"></Border>
                    <Border BorderBrush="Black" Grid.Row="1" BorderThickness="1"></Border>
                    <StackPanel Grid.Row="0" Margin="0, 5, 0, 10" Grid.ColumnSpan="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="204*"/>
                                <ColumnDefinition Width="5*"/>
                            </Grid.ColumnDefinitions>
                            <Label FontSize="16" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Top">Пациент</Label>
                            <ComboBox x:Name="PatientCardD" Width="216" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top" SelectedItem="{Binding SelectedCardPatient}" DisplayMemberPath="FullName" SelectedValuePath="Id" ItemsSource="{Binding Path = DataContext.AllPatients, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                            <Button Content="Показать" Grid.Column="2" Margin="10,0,0,0" Command="{Binding ShowPatientCard}" CommandParameter="{Binding SelectedCardPatient}"/>
                        </Grid>
                    </StackPanel>
                    <DataGrid x:Name="CardGrid" Grid.Row="1" ItemsSource="{Binding PatientCard}" VerticalAlignment="Top" Grid.RowSpan="2" Margin="1, 1, 0, 0" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" VirtualizingPanel.ScrollUnit="Pixel">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Врач" Binding="{Binding Doctor.FullName, StringFormat=d}" Width="*"></DataGridTextColumn>
                            <DataGridTextColumn Header="Дата" Binding="{Binding DateT, StringFormat=d}" Width="*"></DataGridTextColumn>
                            <DataGridTextColumn Header="Время" Binding="{Binding TimeT}" Width="*"></DataGridTextColumn>
                            <DataGridTextColumn Header="Диагноз" Binding="{Binding Diagnosis.Name, StringFormat=d}" Width="*"></DataGridTextColumn>
                            <DataGridTextColumn Header="Рецепт" Binding="{Binding Recipe}" Width="*"/>
                            <DataGridTextColumn Header="Процедура" Binding="{Binding Procedure.Name, StringFormat=d}" Width="*"></DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Записи">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <DatePicker x:Name="AddVisitDate"  Grid.Column="0" HorizontalAlignment="Center" SelectedDate="{Binding SelectedDate}" Width="100" Margin="0, 10, 0, 10"/>
                        <Button x:Name="GetTalonsBtn" Grid.Column="1" Content="Показать записи" Margin="15, 0, 0, 0" Command="{Binding GetTalonsCommand}"/>
                    </Grid>
                    <Border BorderBrush="Black" BorderThickness="1">
                        <StackPanel Grid.Row="0" Margin="0, 5, 0, 10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="Black" BorderThickness="1"/>
                        <DataGrid Grid.Column="0" ItemsSource="{Binding Talons, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding SelectedTalon, Mode=TwoWay}" VerticalAlignment="Top" Grid.RowSpan="2" Margin="1, 1, 0, 0" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Время" Binding="{Binding Time}" Width="*"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <GroupBox x:Name="DoctorVisitInfo" Header="Сведения о записи" Margin="4" Grid.Row="1" Width="390">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Label Grid.Column="0" Grid.Row="0" Content="Дата:"/>
                                    <Label Grid.Column="0" Grid.Row="1" Content="Время:"/>
                                    <Label Grid.Column="0" Grid.Row="2" Content="Пациент:"/>
                                    <Label Grid.Column="0" Grid.Row="3" Content="Диагноз:"/>
                                    <Label Grid.Column="0" Grid.Row="4" Content="Процедура:"/>
                                    <Label Grid.Column="0" Grid.Row="5" Content="Рецепт:"/>
                                    <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding SelectedTalon.Date, StringFormat={}{0:D}, ConverterCulture=ru}"/>
                                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding SelectedTalon.Time, StringFormat={}{0:t}}"/>
                                    <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding SelectedTalon.Patient.FullName}"/>
                                    <ComboBox Grid.Column="1" Grid.Row="3" SelectedItem="{Binding SelectedDiagnosisVisit, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" DisplayMemberPath="Name" SelectedValue="{Binding Diagnosis_id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Id" ItemsSource="{Binding Path=DataContext.AllDiagnosis, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                                    <ComboBox Grid.Column="1" Grid.Row="4" SelectedItem="{Binding SelectedProcedure, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" DisplayMemberPath="Name" SelectedValue="{Binding Procedure_id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Id" ItemsSource="{Binding Path=DataContext.AllProcedures, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
                                    <TextBox Grid.Column="1" Grid.Row="5" Text="{Binding SelectedRecipe, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                                    <Button Grid.Column="0" Grid.Row="6" HorizontalAlignment="Center" Content="Завершить запись" Margin="0, 10, 0, 0" Command="{Binding CompleteVisitCommand}" CommandParameter="{Binding SelectedTalon}"/>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Диагнозы">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="Black" Grid.Row="0" BorderThickness="1"></Border>
                    <Border BorderBrush="Black" Grid.Row="1" BorderThickness="1"></Border>
                    <StackPanel Grid.Row="0" Margin="0, 5, 0, 10" Grid.ColumnSpan="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Width="200" Text="{Binding NewDiagnosisName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Content="Добавить диагноз" Command="{Binding AddDiagnosisCommand}" HorizontalAlignment="Center" Margin="20, 0, 0, 0"/>
                            <Button Grid.Column="2" Content="Удалить диагноз" Command="{Binding DeleteDiagnosisCommand}" CommandParameter="{Binding SelectedDiagnosis}" HorizontalAlignment="Center" Margin="20, 0, 0, 0"/>
                        </Grid>
                    </StackPanel>
                    <DataGrid x:Name="DiagnosisGrid" Grid.Row="1" ItemsSource="{Binding AllDiagnosis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding SelectedDiagnosis, Mode=TwoWay}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Статистика диагнозов">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Label FontSize="16" FontWeight="Black" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">C</Label>
                        <DatePicker x:Name="BeginReportDate"  Grid.Column="1" HorizontalAlignment="Center" SelectedDate="{Binding BeginReportDate}" Width="100" Margin="10, 0, 0, 0"/>
                        <Label FontSize="16" FontWeight="Black" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Top">До</Label>
                        <DatePicker x:Name="EndReportDate"  Grid.Column="3" HorizontalAlignment="Center" SelectedDate="{Binding EndReportDate}" Width="100" Margin="10, 0, 0, 0"/>
                        <Button Grid.Column="4" VerticalAlignment="Top" Width="150" Margin="10, 10, 0, 0" Content="Составить отчёт" Command="{Binding GetReportCommand}"/>
                        <Button Grid.Column="5" Content="Сохранить в файл" Width="200" Margin="10, 10, 0, 0" Command="{Binding SaveFileCommand}"/>
                    </Grid>
                    <lvc:PieChart Grid.Row="1" Margin="0, 10, 0, 0" Series="{Binding Series}" Hoverable="True" LegendLocation="Left"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
