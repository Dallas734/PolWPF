<Window x:Class="PolWPF.DoctorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PolWPF"
        mc:Ignorable="d"
        Title="DoctorWindow" Height="450" Width="1200"
        xmlns:materialDesignMahApps="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid>
        <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1"/>
        <TabControl Grid.Column="0" TabStripPlacement="Left" BorderThickness="5, 10, 15, 20" BorderBrush="Black">
            <TabItem Header="Карта пациента">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="Black" Grid.Row="0" BorderThickness="1"></Border>
                    <Border BorderBrush="Black" Grid.Row="1" BorderThickness="1"></Border>
                    <StackPanel Grid.Row="0" Margin="0, 5, 0, 10" Grid.ColumnSpan="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label FontSize="16" FontWeight="Black" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">Пациент</Label>
                            <ComboBox x:Name="PatientCardD" Width="216" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        </Grid>
                    </StackPanel>
                    <DataGrid x:Name="CardGridD" Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}" VerticalAlignment="Top" Grid.RowSpan="2" Margin="1, 1, 0, 0"/>
                </Grid>
            </TabItem>
            <TabItem Header="Записи">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="Black" BorderThickness="1">
                        <StackPanel Grid.Row="0" Margin="0, 5, 0, 10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="Black" BorderThickness="1"/>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <GroupBox Header="Дата" BorderBrush="Black">
                                <StackPanel Orientation="Vertical">
                                    <DatePicker x:Name="guidDateDoctor"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="Пред" x:Name="guifDatePrevDoctor" Grid.Column="0" Margin="4"/>
                                        <Button Content="Сегодня" x:Name="guifDateTodayDoctor" Grid.Column="1" Margin="4"/>
                                        <Button Content="След" x:Name="guifDateNextDoctor" Grid.Column="2" Margin="4"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox x:Name="DoctorVisitInfo" Header="Сведения о записи" Margin="4" Grid.Row="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Label Grid.Column="0" Grid.Row="0" Content="Дата:"/>
                                    <Label Grid.Column="0" Grid.Row="1" Content="Время:"/>
                                    <Label Grid.Column="0" Grid.Row="2" Content="Пациент:"/>
                                    <Label Grid.Column="0" Grid.Row="3" Content="Диагноз:"/>
                                    <Label Grid.Column="0" Grid.Row="4" Content="Процедура:"/>
                                    <Label Grid.Column="0" Grid.Row="5" Content="Рецепт:"/>
                                    <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Start, StringFormat={}{0:D}}"/>
                                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Start, StringFormat={}{0:t}}"/>
                                    <ComboBox Grid.Column="1" Grid.Row="3" Text="{Binding DiagnosisV}"/>
                                    <ComboBox Grid.Column="1" Grid.Row="4" Text="{Binding ProcedureV}"/>
                                    <TextBlock Grid.Column="1" Grid.Row="5" Text="{Binding RecipeV}"/>
                                    <Button Grid.Column="0" Grid.Row="6" HorizontalAlignment="Center" Content="Сохранить" Margin="0, 10, 0, 0"/>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Диагнозы">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="Black" Grid.Row="0" BorderThickness="1"></Border>
                    <Border BorderBrush="Black" Grid.Row="1" BorderThickness="1"></Border>
                    <StackPanel Grid.Row="0" Margin="0, 5, 0, 10" Grid.ColumnSpan="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label FontSize="16" FontWeight="Black" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">Диагноз</Label>
                            <ComboBox x:Name="DiagnosisCombo" Width="216" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" />
                            <Button Grid.Column="2" Content="Добавить диагноз" HorizontalAlignment="Center" Margin="20, 0, 0, 0"/>
                            <Button Grid.Column="3" Content="Удалить диагноз" HorizontalAlignment="Center" Margin="20, 0, 0, 0"/>
                            <Button Grid.Column="4" Content="Сохранить " HorizontalAlignment="Center" Margin="20, 0, 0, 0"/>
                        </Grid>
                    </StackPanel>
                    <DataGrid x:Name="DiagnosisGrid" Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}" VerticalAlignment="Top" Grid.RowSpan="2" Margin="1, 1, 0, 0"/>
                </Grid>
            </TabItem>
            <TabItem Header="Статистика диагнозов">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button VerticalAlignment="Top" Width="150" Margin="0, 20, 0, 0" Content="Составить отчёт"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
