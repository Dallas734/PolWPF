<Window x:Class="PolWPF.RegistratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PolWPF"
        mc:Ignorable="d"
        Title="RegistratorWindow" Height="480" Width="1200"
        xmlns:materialDesignMahApps="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid x:Name="BackGrid">
        <TabControl TabStripPlacement="Left" BorderThickness="5, 10, 15, 20" BorderBrush="Black">
            <TabItem Header="Пациенты">
                <TabControl BorderThickness="5, 10, 15, 20" BorderBrush="Black">
                    <TabItem Header="Сведения о пациенте">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="Black" Grid.Row="0" BorderThickness="1"></Border>
                            <Border BorderBrush="Black" Grid.Row="1" BorderThickness="1"></Border>
                            <StackPanel Grid.Row="0" Margin="0, 5, 0, 10" Grid.ColumnSpan="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label FontSize="16" FontWeight="Black" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">Пациент</Label>
                                    <ComboBox x:Name="PatientInfo" Width="216" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                    <Button x:Name="AddPatientBtn" Grid.Column="2" Width="200" Content="Добавить пациента" HorizontalAlignment="Left" Margin="10, 0, 0, 0"/>
                                </Grid>
                            </StackPanel>
                            <DataGrid x:Name="PatientGridInfo" Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}" VerticalAlignment="Top" Grid.RowSpan="2" Margin="1, 1, 0, 0"/>
                        </Grid>
                    </TabItem>
                    <TabItem  Header="Записать пациента">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="Black" BorderThickness="1">
                                <StackPanel Grid.Row="0" Margin="0, 5, 0, 10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label FontSize="16" FontWeight="Black" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">Врач</Label>
                                        <ComboBox x:Name="DoctorComboAddVisit" Width="216" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border BorderBrush="Black" BorderThickness="1">
                                    <local:SheduleWeek x:Name="ScheduleWeek"/>
                                </Border>
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <GroupBox x:Name="guicEvent" Header="Сведения о записи" Margin="4" Grid.Row="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Label Grid.Column="0" Grid.Row="0" Content="Дата:"/>
                                            <Label Grid.Column="0" Grid.Row="1" Content="Время:"/>
                                            <Label Grid.Column="0" Grid.Row="2" Content="Врач:"/>
                                            <Label Grid.Column="0" Grid.Row="3" Content="Пациент:"/>
                                            <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Start, StringFormat={}{0:D}}"/>
                                            <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Start, StringFormat={}{0:t}}"/>
                                            <TextBlock Grid.Column="1" Grid.Row="3" Text="{Binding DoctorT}"/>
                                            <TextBlock Grid.Column="1" Grid.Row="4" Text="{Binding PatientT}"/>
                                        </Grid>
                                    </GroupBox>
                                    <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="4">
                                        <Button Content="Новая запись" x:Name="guifEventNew" Margin="8,0,0,0"/>
                                        <Button Content="Удалить запись" x:Name="guifEventDelete" Margin="8,0,0,0" IsEnabled="False"/>
                                    </StackPanel>
                                    <GroupBox x:Name="guicEventEdit" Header="Новая запись" Margin="4" Grid.Row="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Label Grid.Column="0" Grid.Row="0" Content="Дата:"/>
                                            <Label Grid.Column="0" Grid.Row="1" Content="Время:"/>
                                            <Label Grid.Column="0" Grid.Row="2" Content="Пациент:"/>
                                            <DatePicker x:Name="guiEventEditDate" Grid.Column="1" Grid.Row="0"/>
                                            <materialDesignMahApps:TimePicker x:Name="guiEventEditTime" Grid.Column="1" Grid.Row="1"/>
                                            <ComboBox x:Name="PatientComboAddVisit" Grid.Column="1" Grid.Row="2"/>
                                            <Button x:Name="guiEventEditSave" Grid.Column="1" Grid.Row="5" Content="Save" HorizontalAlignment="Left" Width="100" Margin="0, 2, 0, 0"/>
                                        </Grid>
                                    </GroupBox>
                                </Grid>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Записи пациента">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="Black" BorderThickness="1">
                                <StackPanel Grid.Row="0" Margin="0, 5, 0, 10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label FontSize="16" FontWeight="Black" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">Пациент</Label>
                                        <ComboBox x:Name="PatientVisitsInfo" Width="216" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border BorderBrush="Black" BorderThickness="1">
                                    <local:SheduleDay x:Name="SheduleDay" />
                                </Border>
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <GroupBox Header="Дата" BorderBrush="Black">
                                        <StackPanel Orientation="Vertical">
                                            <DatePicker x:Name="guidDate" SelectedDateChanged="GuidDate_SelectedDateChanged"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Content="Пред" x:Name="guifDatePrev" Click="GuifDatePrev_Click" Grid.Column="0" Margin="4"/>
                                                <Button Content="Сегодня" x:Name="guifDateToday" Click="GuifDateToday_Click" Grid.Column="1" Margin="4"/>
                                                <Button Content="След" x:Name="guifDateNext" Click="GuifDateNext_Click" Grid.Column="2" Margin="4"/>
                                            </Grid>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox x:Name="VisitInfo" Header="Сведения о записи" Margin="4" Grid.Row="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Label Grid.Column="0" Grid.Row="0" Content="Дата:"/>
                                            <Label Grid.Column="0" Grid.Row="1" Content="Время:"/>
                                            <Label Grid.Column="0" Grid.Row="2" Content="Врач:"/>
                                            <Label Grid.Column="0" Grid.Row="3" Content="Пациент:"/>
                                            <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Start, StringFormat={}{0:D}}"/>
                                            <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Start, StringFormat={}{0:t}}"/>
                                            <TextBlock Grid.Column="1" Grid.Row="3" Text="{Binding DoctorT}"/>
                                            <TextBlock Grid.Column="1" Grid.Row="4" Text="{Binding PatientT}"/>
                                        </Grid>
                                    </GroupBox>
                                </Grid>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Карта пациента">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="Black" Grid.Row="0" BorderThickness="1"></Border>
                            <Border BorderBrush="Black" Grid.Row="1" BorderThickness="1"></Border>
                            <StackPanel Grid.Row="0" Margin="0, 5, 0, 10" Grid.ColumnSpan="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label FontSize="16" FontWeight="Black" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">Пациент</Label>
                                    <ComboBox x:Name="PatientCard" Width="216" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                </Grid>
                            </StackPanel>
                            <DataGrid x:Name="CardGrid" Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}" VerticalAlignment="Top" Grid.RowSpan="2" Margin="1, 1, 0, 0"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>
            <TabItem Header="Врачи">
                <TabControl>
                    <TabItem Header="Сведения о врачах (участки, статус)">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="Black" Grid.Row="0" BorderThickness="1"></Border>
                            <Border BorderBrush="Black" Grid.Row="1" BorderThickness="1"></Border>
                            <StackPanel Grid.Row="0" Margin="0, 5, 0, 10" Grid.ColumnSpan="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label FontSize="16" FontWeight="Black" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">Доктор</Label>
                                    <ComboBox x:Name="DoctorInfo" Width="216" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                </Grid>
                            </StackPanel>
                            <DataGrid x:Name="DoctorGridInfo" Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}" VerticalAlignment="Top" Grid.RowSpan="2" Margin="1, 1, 0, 0"/>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Расписание врача">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="Black" BorderThickness="1">
                                <StackPanel Grid.Row="0" Margin="0, 5, 0, 10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Label FontSize="16" FontWeight="Black" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">Врач</Label>
                                        <ComboBox x:Name="DoctorSheduleInfo" Width="216" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Label x:Name="Monday" FontSize="16" FontWeight="Black" HorizontalAlignment="Left">Понедельник</Label>
                                    <Label x:Name="Tuesday" FontSize="16" FontWeight="Black" HorizontalAlignment="Left">Вторник</Label>
                                    <Label x:Name="Wednesday" FontSize="16" FontWeight="Black" HorizontalAlignment="Left">Среда</Label>
                                    <Label x:Name="Thursday" FontSize="16" FontWeight="Black" HorizontalAlignment="Left">Четверг</Label>
                                    <Label x:Name="Friday" FontSize="16" FontWeight="Black" HorizontalAlignment="Left">Пятница</Label>
                                    <Label x:Name="Saturday" FontSize="16" FontWeight="Black" HorizontalAlignment="Left">Суббота</Label>
                                    <Label x:Name="Sunday" FontSize="16" FontWeight="Black" HorizontalAlignment="Left">Воскресенье</Label>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <materialDesignMahApps:TimePicker x:Name="MondayBeginTime" Width="100" Margin="0, 1, 0, 0"/>
                                    <materialDesignMahApps:TimePicker x:Name="TuesdayBeginTime" Width="100" Margin="0, 5, 0, 0"/>
                                    <materialDesignMahApps:TimePicker x:Name="WednesdayBeginTime" Width="100" Margin="0, 5, 0, 0"/>
                                    <materialDesignMahApps:TimePicker x:Name="ThursdayBeginTime" Width="100" Margin="0, 5, 0, 0"/>
                                    <materialDesignMahApps:TimePicker x:Name="FridayBeginTime" Width="100" Margin="0, 5, 0, 0"/>
                                    <materialDesignMahApps:TimePicker x:Name="SaturdayBeginTime" Width="100" Margin="0, 5, 0, 0"/>
                                    <materialDesignMahApps:TimePicker x:Name="SundayBeginTime" Width="100" Margin="0, 5, 0, 0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="30,0 ,0, 0">
                                    <materialDesignMahApps:TimePicker x:Name="MondayEndTime" Width="100" Margin="0, 1, 0, 0"/>
                                    <materialDesignMahApps:TimePicker x:Name="TuesdayEndTime" Width="100" Margin="0, 5, 0, 0"/>
                                    <materialDesignMahApps:TimePicker x:Name="WednesdayEndTime" Width="100" Margin="0, 5, 0, 0"/>
                                    <materialDesignMahApps:TimePicker x:Name="ThursdayEndTime" Width="100" Margin="0, 5, 0, 0"/>
                                    <materialDesignMahApps:TimePicker x:Name="FridayEndTime" Width="100" Margin="0, 5, 0, 0"/>
                                    <materialDesignMahApps:TimePicker x:Name="SaturdayEndTime" Width="100" Margin="0, 5, 0, 0"/>
                                    <materialDesignMahApps:TimePicker x:Name="SundayEndTime" Width="100" Margin="0, 5, 0, 0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Записи врача">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="Black" BorderThickness="1">
                                <StackPanel Grid.Row="0" Margin="0, 5, 0, 10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Label FontSize="16" FontWeight="Black" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">Врач</Label>
                                        <ComboBox x:Name="DoctorVisitsInfo" Width="216" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border BorderBrush="Black" BorderThickness="1">
                                    <local:SheduleDay x:Name="SheduleDayDoctor" />
                                </Border>
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <GroupBox Header="Дата" BorderBrush="Black">
                                        <StackPanel Orientation="Vertical">
                                            <DatePicker x:Name="guidDateDoctor" SelectedDateChanged="GuidDate_SelectedDateChanged"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Content="Пред" x:Name="guifDatePrevDoctor" Click="GuifDatePrev_Click" Grid.Column="0" Margin="4"/>
                                                <Button Content="Сегодня" x:Name="guifDateTodayDoctor" Click="GuifDateToday_Click" Grid.Column="1" Margin="4"/>
                                                <Button Content="След" x:Name="guifDateNextDoctor" Click="GuifDateNext_Click" Grid.Column="2" Margin="4"/>
                                            </Grid>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox x:Name="DoctorVisitInfo" Header="Сведения о записи" Margin="4" Grid.Row="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Label Grid.Column="0" Grid.Row="0" Content="Дата:"/>
                                            <Label Grid.Column="0" Grid.Row="1" Content="Время:"/>
                                            <Label Grid.Column="0" Grid.Row="2" Content="Врач:"/>
                                            <Label Grid.Column="0" Grid.Row="3" Content="Пациент:"/>
                                            <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Start, StringFormat={}{0:D}}"/>
                                            <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Start, StringFormat={}{0:t}}"/>
                                            <TextBlock Grid.Column="1" Grid.Row="3" Text="{Binding DoctorT}"/>
                                            <TextBlock Grid.Column="1" Grid.Row="4" Text="{Binding PatientT}"/>
                                        </Grid>
                                    </GroupBox>
                                </Grid>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Статистика посещений на участке">
                    </TabItem>
                </TabControl>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
