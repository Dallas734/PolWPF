<UserControl x:Class="PolWPF.SheduleWeek"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PolWPF"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Label x:Name="Title" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Border x:Name="Top" BorderThickness="0,0,0,1" BorderBrush="Black" Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Понедельник" Grid.Column="1"/>
                <Label Content="Вторник" Grid.Column="2"/>
                <Label Content="Среда" Grid.Column="3"/>
                <Label Content="Четверг" Grid.Column="4"/>
                <Label Content="Пятница" Grid.Column="5"/>
                <Label Content="Суббота" Grid.Column="6"/>
                <Label Content="Воскресенье" Grid.Column="7"/>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="2" x:Name="Scroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid x:Name="SheduleGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="GridTimeline" Grid.Column="0" Grid.Row="0"
        BorderBrush="Black" BorderThickness="0,0,1,0"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Canvas x:Name="CanvasMonday" Grid.Column="1" Background="Transparent"/>
                    <Canvas x:Name="CanvasTuesday" Grid.Column="2" Background="Transparent"/>
                    <Canvas x:Name="CanvasWednesday" Grid.Column="3" Background="Transparent"/>
                    <Canvas x:Name="CanvasThursday" Grid.Column="4" Background="Transparent"/>
                    <Canvas x:Name="CanvasFriday" Grid.Column="5" Background="Transparent"/>
                    <Canvas x:Name="CanvasSaturday" Grid.Column="6" Background="Transparent"/>
                    <Canvas x:Name="CanvasSunday" Grid.Column="7" Background="Transparent"/>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
